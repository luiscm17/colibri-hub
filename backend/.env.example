# Copy this file to backend/.env for local development. Do not commit backend/.env.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=<TEST_DATABASE_URL> # equals DATABASE_URL for local dev if needed

# Supabase Auth — required for Authentication capability.
# Get these values from `pnpm supabase status --output json` after starting the local instance.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx_placeholder
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
