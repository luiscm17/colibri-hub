### Variables
@host = http://127.0.0.1:8000
@supabase = http://127.0.0.1:54321
@anon_key = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Access token — expires after ~1h. Run the Sign in request below, copy the
# access_token from the response, and paste it here. See CREDENTIALS.md.
@token = <paste_access_token_here>
@ordinary_token = <paste_operator_access_token_here>

# IDs below are instance-specific: fill them from the corresponding list GET
# before running requests that reference them.
@scope_id = <paste_active_scope_id_here>
@role_detail_id = <paste_role_id_here>
@user_id = <paste_user_id_here>
@role_id = <paste_role_id_here>
@preset_id = <paste_preset_id_here>
@preview_subject_version = <paste_subject_version_here>
@preset_version = <paste_current_preset_version_here>

### ─────────────────────────────────────────────────────
### Sign in — get fresh access_token
### ─────────────────────────────────────────────────────

POST {{supabase}}/auth/v1/token?grant_type=password
apikey: {{anon_key}}
Content-Type: application/json

{
  "email": "admin@colibri.test",
  "password": "AdminTest123!"
}

### ═════════════════════════════════════════════════════
###                SELF-ACCESS
### ═════════════════════════════════════════════════════

### ─────────────────────────────────────────────────────
### GET /access/me — current user effective permissions
### ─────────────────────────────────────────────────────

GET {{host}}/api/v1/access/me
Authorization: Bearer {{token}}

### ─────────────────────────────────────────────────────
### GET /access/me — unauthenticated (expect 401)
### ─────────────────────────────────────────────────────

GET {{host}}/api/v1/access/me

### ═════════════════════════════════════════════════════
###         SCOPE DEFINITIONS (catalog)
### ═════════════════════════════════════════════════════

### ─────────────────────────────────────────────────────
### GET /access/scope-definitions — list recognized catalog
### ─────────────────────────────────────────────────────

GET {{host}}/api/v1/access/scope-definitions
Authorization: Bearer {{token}}

### ═════════════════════════════════════════════════════
###              SCOPES (registered)
### ═════════════════════════════════════════════════════

### ─────────────────────────────────────────────────────
### GET /access/scopes — list registered scopes (paginated)
### ─────────────────────────────────────────────────────

GET {{host}}/api/v1/access/scopes?page=1&page_size=50
Authorization: Bearer {{token}}

### ─────────────────────────────────────────────────────
### POST /access/scopes — register a recognized scope
### ─────────────────────────────────────────────────────

POST {{host}}/api/v1/access/scopes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "definition_key": "warehouse.raw_materials",
  "reason": "Enable warehouse raw materials scope for role configuration"
}

### ─────────────────────────────────────────────────────
### POST /access/scopes — register access_control scope
### ⚠ 409 (duplicate) when already registered by setup/bootstrap
### ─────────────────────────────────────────────────────

POST {{host}}/api/v1/access/scopes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "definition_key": "access_control",
  "reason": "Enable access control scope for system administration"
}

### ─────────────────────────────────────────────────────
### POST /access/scopes — unrecognized (expect 422)
### ─────────────────────────────────────────────────────

POST {{host}}/api/v1/access/scopes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "definition_key": "unknown.fake.scope",
  "reason": "This should fail"
}

### ─────────────────────────────────────────────────────
### PATCH /access/scopes/{id}/status — deactivate scope
### @scope_id_to_deactivate — paste a scope_id from GET /access/scopes.
###   ⚠ expected_version must equal the scope's current version.
### ─────────────────────────────────────────────────────

@scope_id_to_deactivate = <paste_scope_id_here>

PATCH {{host}}/api/v1/access/scopes/{{scope_id_to_deactivate}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "is_active": false,
  "expected_version": 1,
  "reason": "Deactivate scope for testing"
}

### ─────────────────────────────────────────────────────
### PATCH /access/scopes/{id}/status — reactivate scope
### ─────────────────────────────────────────────────────

PATCH {{host}}/api/v1/access/scopes/{{scope_id_to_deactivate}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "is_active": true,
  "expected_version": 2,
  "reason": "Reactivate scope after testing"
}

### ═════════════════════════════════════════════════════
###                  ROLES
### ═════════════════════════════════════════════════════

### ─────────────────────────────────────────────────────
### GET /access/roles — list all roles (paginated)
### ─────────────────────────────────────────────────────

GET {{host}}/api/v1/access/roles?page=1&page_size=50
Authorization: Bearer {{token}}

### ─────────────────────────────────────────────────────
### POST /access/roles — create an ordinary role
### @scope_id — paste a scope_id from GET /access/scopes
### ─────────────────────────────────────────────────────

POST {{host}}/api/v1/access/roles
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role_code": "warehouse-reader",
  "role_name": "Warehouse Reader",
  "description": "Read access to warehouse raw materials",
  "permissions": [
    {"action": "read", "scope_id": "{{scope_id}}"}
  ],
  "reason": "Initial role for warehouse consultation"
}

### ─────────────────────────────────────────────────────
### GET /access/roles/{id} — get role detail
### @role_detail_id — paste a role_id from GET /access/roles.
###   ⚠ expected_version must equal the role's current version.
### ─────────────────────────────────────────────────────

GET {{host}}/api/v1/access/roles/{{role_detail_id}}
Authorization: Bearer {{token}}

### ─────────────────────────────────────────────────────
### PUT /access/roles/{id} — update role (full-replace permissions)
### ─────────────────────────────────────────────────────

PUT {{host}}/api/v1/access/roles/{{role_detail_id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role_name": "Warehouse Reader + Writer",
  "description": "Full access to warehouse raw materials",
  "permissions": [
    {"action": "read", "scope_id": "{{scope_id}}"},
    {"action": "write", "scope_id": "{{scope_id}}"}
  ],
  "expected_version": 1,
  "reason": "Expand role to include write access"
}

### ─────────────────────────────────────────────────────
### PATCH /access/roles/{id}/status — deactivate role
### ─────────────────────────────────────────────────────

PATCH {{host}}/api/v1/access/roles/{{role_detail_id}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "is_active": false,
  "expected_version": 2,
  "reason": "Deactivate role for testing"
}

### ─────────────────────────────────────────────────────
### PATCH /access/roles/{id}/status — reactivate role
### ─────────────────────────────────────────────────────

PATCH {{host}}/api/v1/access/roles/{{role_detail_id}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "is_active": true,
  "expected_version": 3,
  "reason": "Reactivate role after testing"
}

### ─────────────────────────────────────────────────────
### POST /access/roles — privileged action (expect 422)
### ─────────────────────────────────────────────────────

POST {{host}}/api/v1/access/roles
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role_code": "sneaky-admin",
  "role_name": "Sneaky Admin",
  "permissions": [
    {"action": "manage_access", "scope_id": "{{scope_id}}"}
  ],
  "reason": "This should fail — privileged action"
}

### ═════════════════════════════════════════════════════
###              ROLE IMPACT PREVIEW
### ═════════════════════════════════════════════════════

### POST /access/roles/{id}/preview — preview full permission replacement
### Read-only: does not reserve state, increment versions, write audits, or lock rows.
### Use an existing @role_detail_id and active @scope_id from the list requests.
### The response subject_version is the expected_version for the later PUT.

POST {{host}}/api/v1/access/roles/{{role_detail_id}}/preview
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "permissions": [
    {"action": "read", "scope_id": "{{scope_id}}"},
    {"action": "write", "scope_id": "{{scope_id}}"}
  ]
}

### Confirm the preview with PUT /access/roles/{id}
### Replace the placeholder with subject_version from the preview response.
### If the role changed after preview, this returns 409 access_version_conflict;
### run the preview again instead of retrying with a guessed version.

PUT {{host}}/api/v1/access/roles/{{role_detail_id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role_name": "Warehouse Reader + Writer",
  "description": "Full access to warehouse raw materials",
  "permissions": [
    {"action": "read", "scope_id": "{{scope_id}}"},
    {"action": "write", "scope_id": "{{scope_id}}"}
  ],
  "expected_version": {{preview_subject_version}},
  "reason": "Confirm reviewed role impact"
}

### Role preview with ordinary user (expect 403 access_denied)

POST {{host}}/api/v1/access/roles/{{role_detail_id}}/preview
Authorization: Bearer {{ordinary_token}}
Content-Type: application/json

{
  "permissions": []
}

### ═════════════════════════════════════════════════════
###                  ROLE PRESETS
### ═════════════════════════════════════════════════════

### GET /access/role-presets — list presets (1 of 6)

GET {{host}}/api/v1/access/role-presets?page=1&page_size=50
Authorization: Bearer {{token}}

### POST /access/role-presets — create active preset, version 1 (2 of 6)
### Use a unique preset_code when rerunning this state-changing request.

POST {{host}}/api/v1/access/role-presets
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "preset_code": "warehouse-reader-template",
  "preset_name": "Warehouse Reader Template",
  "description": "Starting permissions for warehouse readers",
  "permissions": [
    {"action": "read", "scope_id": "{{scope_id}}"}
  ],
  "reason": "Create a reusable manual-test preset"
}

### GET /access/role-presets/{id} — get current version (3 of 6)
### Set @preset_id from the create response or list response.

GET {{host}}/api/v1/access/role-presets/{{preset_id}}
Authorization: Bearer {{token}}

### PUT /access/role-presets/{id} — full permission replacement (4 of 6)
### Replace expected_version with the current version from GET preset detail.

PUT {{host}}/api/v1/access/role-presets/{{preset_id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "preset_name": "Warehouse Reader and Writer Template",
  "description": "Starting permissions for warehouse readers and writers",
  "permissions": [
    {"action": "read", "scope_id": "{{scope_id}}"},
    {"action": "write", "scope_id": "{{scope_id}}"}
  ],
  "expected_version": {{preset_version}},
  "reason": "Expand the reusable preset"
}

### PATCH /access/role-presets/{id}/status — deactivate (5 of 6)
### Re-read preset detail after every mutation and paste its current version.

PATCH {{host}}/api/v1/access/role-presets/{{preset_id}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "is_active": false,
  "expected_version": {{preset_version}},
  "reason": "Verify preset deactivation"
}

### PATCH /access/role-presets/{id}/status — reactivate before role creation

PATCH {{host}}/api/v1/access/role-presets/{{preset_id}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "is_active": true,
  "expected_version": {{preset_version}},
  "reason": "Restore preset for role creation"
}

### POST /access/role-presets/{id}/roles — copy preset into new role (6 of 6)
### Use a unique role_code when rerunning. Later preset updates do not alter it.

POST {{host}}/api/v1/access/role-presets/{{preset_id}}/roles
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role_code": "warehouse-preset-copy",
  "role_name": "Warehouse Preset Copy",
  "description": "Independent role copied from a preset",
  "reason": "Verify copy-on-create semantics"
}

### Preset list with ordinary user (expect 403 access_denied)

GET {{host}}/api/v1/access/role-presets?page=1&page_size=50
Authorization: Bearer {{ordinary_token}}

### ═════════════════════════════════════════════════════
###                  USERS
### ═════════════════════════════════════════════════════

### ─────────────────────────────────────────────────────
### GET /access/users — list all access users (paginated)
### ─────────────────────────────────────────────────────

GET {{host}}/api/v1/access/users?page=1&page_size=50
Authorization: Bearer {{token}}

### ─────────────────────────────────────────────────────
### GET /access/users/{id} — get user detail
### @user_id — paste a user_id from GET /access/users.
###   ⚠ expected_version must equal the user's current version.
### ─────────────────────────────────────────────────────

GET {{host}}/api/v1/access/users/{{user_id}}
Authorization: Bearer {{token}}

### ─────────────────────────────────────────────────────
### PATCH /access/users/{id}/status — deactivate user
### ─────────────────────────────────────────────────────

PATCH {{host}}/api/v1/access/users/{{user_id}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "is_active": false,
  "expected_version": 1,
  "reason": "Deactivate user for testing"
}

### ─────────────────────────────────────────────────────
### PATCH /access/users/{id}/status — reactivate user
### ─────────────────────────────────────────────────────

PATCH {{host}}/api/v1/access/users/{{user_id}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "is_active": true,
  "expected_version": 2,
  "reason": "Reactivate user after testing"
}

### ─────────────────────────────────────────────────────
### PUT /access/users/{id}/roles — replace user roles
### @role_id — paste a role_id from GET /access/roles
### ─────────────────────────────────────────────────────

PUT {{host}}/api/v1/access/users/{{user_id}}/roles
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role_ids": ["{{role_id}}"],
  "expected_version": 3,
  "reason": "Assign warehouse reader role"
}

### POST /access/users/{id}/roles/preview — preview complete role replacement
### Read-only: this does not change assignments, versions, audits, or locks.
### Use an existing @user_id and one or more active @role_id values.
### The response subject_version is the expected_version for the later PUT.

POST {{host}}/api/v1/access/users/{{user_id}}/roles/preview
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role_ids": ["{{role_id}}"]
}

### Confirm the preview with PUT /access/users/{id}/roles
### Replace the placeholder with subject_version from the preview response.
### A concurrent change makes this return 409 access_version_conflict; preview again.

PUT {{host}}/api/v1/access/users/{{user_id}}/roles
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role_ids": ["{{role_id}}"],
  "expected_version": {{preview_subject_version}},
  "reason": "Confirm reviewed role replacement impact"
}

### User-role preview with ordinary user (expect 403 access_denied)

POST {{host}}/api/v1/access/users/{{user_id}}/roles/preview
Authorization: Bearer {{ordinary_token}}
Content-Type: application/json

{
  "role_ids": ["{{role_id}}"]
}

